        if type(url) ~= "string" or not url:match("^https://discord.com/api/webhooks/") then
            return false, "Invalid webhook URL"
        end
        local last = Webhook.LastAt
        if os.clock() - last < 5 then
            return false, "Webhook cooldown"
        end
        local req = request or http_request or (syn and syn.request)
        if not req then return false, "HTTP request unavailable" end
        local ok, result = pcall(req, {
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = services.HttpService:JSONEncode({
                username = "nevis hub beta",
                embeds = {
                    {
                        title = title or "nevis hub beta",
                        description = desc or "",
                        color = color or 3447003,
                        footer = { text = "Owner: nevis account 2 | discord.gg/zjaPfg3FS" },
                    },
                },
            }),
        })
        Webhook.LastAt = os.clock()
        return ok, result
    end,
}

