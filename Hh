-- ============ UTILS ============
local _throttleStore = {}
local utils = {}

utils.try = function(arg, ...)
    local v = pcall
    local v2 = table.pack(...)
    v2.n = 2 + v2.n - 1
    table.move(v2, 1, v2.n, 2, v2)
    v2[1] = arg
    local v3, v4, v5, v6, v7 = v(table.unpack(v2, 1, v2.n))
    if v3 then return v4, v5, v6, v7 end
    return nil
end

utils.throttle = function(arg, arg2, arg3)
    local now = os.clock()
    if (arg2 or 1) <= now - (_throttleStore[arg] or 0) then
        _throttleStore[arg] = now
        return arg3()
    end
end

utils.firePrompt = function(arg)
    if typeof(arg) ~= "Instance" or not arg:IsA("ProximityPrompt") or not arg.Enabled then
        return false, "Prompt unavailable"
    end
    if type(fireproximityprompt) == "function" then
        if pcall(fireproximityprompt, arg) then return true end
        if pcall(fireproximityprompt, arg, math.max(tonumber(arg.HoldDuration) or 0, 0)) then return true end
    end
    local ok, result = pcall(function()
        arg:InputHoldBegin()
        task.wait(math.max(tonumber(arg.HoldDuration) or 0, 0) + 0.05)
        arg:InputHoldEnd()
    end)
    return ok, result
end

utils.invoke = function(arg, arg2, ...)
    if typeof(arg) ~= "Instance" or not arg:IsA("RemoteFunction") then
        return false, nil, "RemoteFunction unavailable"
    end
    local v = table.pack(...)
    local flag, flag2 = false, false
    local v2, v3 = nil, nil
    task.spawn(function()
        local ok, result, result2 = pcall(function()
            return arg:InvokeServer(table.unpack(v, 1, v.n))
        end)
        flag2 = ok
        v2 = result
        v3 = result2
        flag = true
    end)
    local n = os.clock() + math.max(tonumber(arg2) or 4, 0.25)
    while not flag and os.clock() < n do task.wait(0.03) end
    if not flag then return false, nil, "Remote timeout" end
    return flag2, v2, v3
end

utils.send = function(arg, ...)
    if typeof(arg) ~= "Instance" then return false, nil end
    local v = table.pack(...)
    if arg:IsA("RemoteFunction") then
        return utils.invoke(arg, 4, table.unpack(v, 1, v.n))
    end
    if arg:IsA("RemoteEvent") or arg:IsA("UnreliableRemoteEvent") then
        local ok, result = pcall(function()
            arg:FireServer(table.unpack(v, 1, v.n))
        end)
        return ok, result
    end
    return false, nil
end

utils.toArray = function(arg)
    if type(arg) == "table" then
        local flag = false
        for _, v in pairs(arg) do
            if v == true then flag = true break end
        end
        if flag then
            local tbl3 = {}
            for k, v in pairs(arg) do
                if v == true then table.insert(tbl3, tostring(k)) end
            end
            table.sort(tbl3)
            return tbl3
        end
        return arg
    end
    if arg ~= nil and arg ~= "" then return { tostring(arg) } end
    return {}
end

utils.keysOf = function(arg)
    local tbl3 = {}
    if type(arg) ~= "table" then return tbl3 end
    for k in next, arg, nil do
        tbl3[#tbl3 + 1] = tostring(k)
    end
    table.sort(tbl3)
    return tbl3
end

