    local rarity = type(st.EggRarity) == "table" and st.EggRarity[category]
    local kg = tonumber(record.Kg or record.Weight or record.WeightKg)
    local muts = nil
    if type(record.Mutations) == "table" then
        for k, m in pairs(record.Mutations) do
            k = type(k) == "string" and k or (type(m) == "string" and m)
            if k then muts = muts and muts .. "/" .. k or k end
        end
    end
    local text = tostring(category)
    if rarity then text = text .. " [" .. tostring(rarity) .. "]" end
    if kg and kg > 0 then text = text .. string.format(" %.2fkg", kg) end
    if muts then text = text .. " {" .. muts .. "}" end
    label.Text = text
    if cfg["Egg ESP Names"] == false then label.Text = "" end
    return label
end

function espManager.clearPool(pool)
    if type(pool) ~= "table" then return 0 end
    local n = 0
    for k, v in pairs(pool) do
        if type(v) == "table" then
