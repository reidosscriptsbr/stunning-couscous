function espManager.updateEggEsp(arg, arg2, arg3)
    if not arg2["Egg ESP"] then
        espManager.clearPool(espManager.EggEspPool)
        return
    end
    local snap = type(arg) == "table" and type(arg.GetAreaEggSnapshot) == "function" and utils.try(arg.GetAreaEggSnapshot) or utils.try(arg.ReadFieldEggs)
    local records = snap and snap.Records
    if not records then return end
    local userId = services.LocalPlayer.UserId
    local seen = {}
    local folders = { "AreaEggSlotsClient", "PlacedEggRenders", "ClientRenderedAssets", "ObjectCache", "FieldEggs", "Eggs" }

    local function findInst(uid, record)
        if type(record) == "table" then
            local i = record.Instance or record.Model or record.Part
            if typeof(i) == "Instance" then return i end
        end
        if uid == nil then return nil end
        local str = tostring(uid)
        for _, fname in ipairs(folders) do
            local f = services.Workspace:FindFirstChild(fname)
            if f then
                local v = f:FindFirstChild(str) or f:FindFirstChild(str, true)
                if v then return v end
                for _, child in ipairs(f:GetChildren()) do
                    if child:GetAttribute("Uid") == str then return child end
                end
            end
        end
        return nil
    end

    for _, v in pairs(records) do
        local uid = v.Uid
        local cat = v.AssetCategory
        if type(uid) == "string" and cat then
            if not v.CarrierUserId or v.CarrierUserId == userId then
                local rarity = arg3.EggRarity[cat] or "Common"
                if (arg3.RarityData[rarity] or 0) >= (tonumber(arg3.EspMinRank) or 0) then
                    local inst = findInst(uid, v)
                    if v.BottomCFrame and v.BottomCFrame.Position or inst and inst:GetPivot().Position then
                        seen[uid] = true
                        local color = arg3.EspColor[rarity] or Color3.new(1, 1, 1)
                        if inst then
                            espManager.applyHighlight(espManager.getHighlight(uid, espManager.EggEspPool), inst, color, 500)
                            if arg2["Egg ESP Names"] ~= false then
                                espManager.applyEggLabel(espManager.getBillboard(uid, espManager.EggEspPool, inst:FindFirstChild("Hitbox") or inst), v, arg3, arg2, color)
                            else
                                local e = espManager.EggEspPool[uid]
                                if e and e.Billboard then e.Billboard.Enabled = false end
                            end
                        end
                    end
                end
            end
        end
    end

    for k, v in pairs(espManager.EggEspPool) do
        if not seen[k] then
            if v.Billboard then pcall(function() v.Billboard:Destroy() end) end
            if v.Highlight then pcall(function() v.Highlight:Destroy() end) end
            espManager.EggEspPool[k] = nil
        end
    end
end

