local function isBlocking(arg)
    if not arg or not arg:IsA("BasePart") then return false end
    local str = arg.Name:lower()
    if arg:GetFullName():lower():find("guard no collide", 1, true) then return false end
    if str:find("bounds") or str:find("zone") or str:find("trigger") or str:find("detector") or str:find("prompt") then
        return false
    end
    return arg.CanCollide or str:find("wall") or str:find("collision")
end

local function getRayParams()
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local f = {}
    local character = services.LocalPlayer.Character
    if character then f[#f + 1] = character end
    for _, v in ipairs({ "ClientRenderedAssets", "Pets" }) do
        local v2 = services.Workspace:FindFirstChild(v)
        if v2 then f[#f + 1] = v2 end
    end
    local objects = services.Workspace:FindFirstChild("__OBJECTS")
    local areas = objects and objects:FindFirstChild("Areas")
    if areas then f[#f + 1] = areas end
    objects = objects and objects:FindFirstChild("Machines")
    if objects then f[#f + 1] = objects end
    rp.FilterDescendantsInstances = f
    return rp, f
end

local function blockCast(a, b, rp)
    local vector = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
    if vector.Magnitude < 2 then return false end
    local v = vector.Unit:Cross(Vector3.new(0, 1, 0))
    local vector2
    if v.Magnitude < 0.1 then vector2 = Vector3.new(1, 0, 0) else vector2 = v.Unit end
    for _, v2 in ipairs({ 0, 2.5 }) do
        for _, v3 in ipairs({ -2, 0, 2 }) do
            local hit = services.Workspace:Raycast(a + Vector3.new(0, v2, 0) + vector2 * v3, vector, rp)
            if hit and isBlocking(hit.Instance) then return true, hit end
        end
    end
    return false
end

local function expandSegment(out, a, b, step)
    local n = math.clamp(math.ceil((b - a).Magnitude / step), 1, 160)
    for i = 1, n do
        local v = a:Lerp(b, i / n)
        out[#out + 1] = CFrame.new(v.X, minSafe(v.Y), v.Z)
    end
end

stealEggTeleport.expandTweenLeg = function(arg, arg2, arg3)
    if typeof(arg) == "CFrame" then arg = arg.Position end
    local position
    if typeof(arg2) == "CFrame" then position = arg2.Position else position = arg2 end
    if typeof(position) == "Instance" then position = position.Position end
    if typeof(arg) ~= "Vector3" or typeof(position) ~= "Vector3" then return {} end
    local n = tonumber(arg3) or 120
    local v = getRayParams()
    v.RespectCanCollide = true
    local tbl2 = { arg }
    local tbl3 = {}
    local flag = false
    for i = 1, 16 do
        local v2, v3 = blockCast(arg, position, v)
        if not (not v2 or not v3 or not v3.Instance) then
            local instance = v3.Instance
            local str = instance:GetFullName() .. ":" .. tostring(math.floor(v3.Position.X)) .. ":" .. tostring(math.floor(v3.Position.Z))
            tbl3[str] = (tbl3[str] or 0) + 1
            if tbl3[str] > 2 then
                flag = true
                break
            else
                local n2 = instance.Size.X / 2 + 8
                local n3 = instance.Size.Z / 2 + 8
                local n4 = instance.CFrame:PointToObjectSpace(arg).X < 0 and -n2 or n2
                local n5 = -n4
                local magnitude = (position - arg).Magnitude
                local tbl4 = {}
                for _, v4 in ipairs({ -n3, n3 }) do
                    local v5 = instance.CFrame:PointToWorldSpace(Vector3.new(n4, 0, v4))
                    local v6 = instance.CFrame:PointToWorldSpace(Vector3.new(n5, 0, v4))
                    local vector = Vector3.new(v5.X, arg.Y, v5.Z)
                    local vector2 = Vector3.new(v6.X, arg.Y, v6.Z)
                    local v7 = blockCast(arg, vector, v)
                    local v8 = blockCast(vector, vector2, v)
                    local magnitude2 = (position - vector2).Magnitude
                    if not v7 and not v8 and magnitude2 < magnitude + 50 then
                        tbl4[#tbl4 + 1] = {
                            A = vector,
                            B = vector2,
                            Score = (vector - arg).Magnitude + (vector2 - vector).Magnitude + magnitude2,
                        }
                    end
                end
                table.sort(tbl4, function(a, b) return a.Score < b.Score end)
                local v4 = tbl4[1]
                if not v4 then
                    flag = true
                    break
                else
                    tbl2[#tbl2 + 1] = v4.A
                    tbl2[#tbl2 + 1] = v4.B
                    arg = v4.B
                    continue
                end
            end
        end
        break
    end
    if flag then return {} end
    if blockCast(arg, position, v) then return {} end
    tbl2[#tbl2 + 1] = position
    local tbl4 = {}
    for i = 2, #tbl2 do
        expandSegment(tbl4, tbl2[i - 1], tbl2[i], n)
    end
    return tbl4
end

local function safeWaypoint(cf, hrp)
    if typeof(cf) ~= "CFrame" or not hrp then return nil, "invalid waypoint" end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local f = {}
    local character = services.LocalPlayer.Character
    if character then f[#f + 1] = character end
    for _, v in ipairs({ "ClientRenderedAssets", "Pets" }) do
        local v2 = services.Workspace:FindFirstChild(v)
        if v2 then f[#f + 1] = v2 end
    end
    rp.FilterDescendantsInstances = f

    local position = cf.Position
    local y = hrp.Position.Y
    local hit = services.Workspace:Raycast(Vector3.new(position.X, math.max(position.Y, y) + 100, position.Z), Vector3.new(0, -650, 0), rp)
    if not hit then return nil, "no ground below waypoint" end
    local n = hit.Position.Y + 3
    local n2 = n - y
    local n3 = position.Y - y
    if math.abs(n2) > 12 then
        if math.abs(n3) <= 12 then
            return CFrame.new(position.X, minSafe(position.Y), position.Z) * cf.Rotation
        end
        return nil, "unsafe vertical ground change"
    end
    return CFrame.new(position.X, minSafe(n), position.Z) * cf.Rotation
end

