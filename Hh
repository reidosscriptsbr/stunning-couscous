end }

-- ============ GUARD RADAR ============
local guardRadar = { tick = function(arg, arg2, arg3)
    if not arg["Guard Threat Radar"] then
        arg2.GuardRadarArea = nil
        return
    end
    local objects = services.Workspace:FindFirstChild("__OBJECTS")
    objects = objects and objects:FindFirstChild("Areas")
    objects = objects and objects:FindFirstChild("GuardAreas")
    if not objects then return end
    local uid = tostring(services.LocalPlayer.UserId)
    local found = nil
    for _, child in ipairs(objects:GetChildren()) do
        local guard = child:FindFirstChild("Guard") or child:FindFirstChild("ForestGuardAuthored")
        if guard then
            local st = guard:GetAttribute("GuardState")
            local target = tostring(guard:GetAttribute("TargetPlayer") or "")
            if st == "Chasing" and target == uid then
                found = child.Name
                break
            end
        end
    end
    if found and arg2.GuardRadarArea ~= found then
        arg2.GuardRadarArea = found
        if type(arg3) == "function" then
            arg3("Guard Radar", found .. " guard is chasing you!", 3)
        end
    elseif not found then
        arg2.GuardRadarArea = nil
    end
end }

