function autoFarmEgg.scanEggs(arg, arg2, arg3)
    if not arg then return nil end
    local snap = type(arg.GetAreaEggSnapshot) == "function" and utils.try(arg.GetAreaEggSnapshot) or (type(arg.ReadFieldEggs) == "function" and utils.try(arg.ReadFieldEggs))
    local records = type(snap) == "table" and snap.Records
    if type(records) ~= "table" then return nil end
    local character = services.LocalPlayer.Character
    character = character and character:FindFirstChild("HumanoidRootPart")
    if not character then return nil end
    local position = character.Position
    local failed = autoFarmEgg.FailedEggs or {}
    local now = os.clock()
    local eggFilter = arg3.SelectEggtoFarmEgg or {}
    local areaFilter = arg3.SelectAreatoFarmEgg or {}
    local rarityFilter = arg3.SelectRaritytoFarmEgg or {}
    local minRank = tonumber(arg3.FarmRarityRank) or 0

    if arg2["Night Farm Sync"] then
        local cycle = arg3.AreaEggCycle
        if not cycle then
            local ok, r = pcall(require, services.ReplicatedStorage.Shared.Util.AreaEggCycle)
            if ok then cycle = r; arg3.AreaEggCycle = r end
        end
        if not cycle or type(cycle.IsNightPhase) ~= "function" or utils.try(cycle.IsNightPhase, services.Workspace:GetServerTimeNow()) ~= true then
            autoFarmEgg.Status = "Waiting for night phase"
            arg3.FarmIdle = true
            return nil
        end
    end

    local best, bestRank, bestDist = nil, -1, math.huge

    for _, v4 in pairs(records) do
        if type(v4) == "table" and v4.AssetCategory and v4.AreaId then
            local uid = v4.Uid
            local dropped = v4.DroppedAt ~= nil or v4.State == "Dropped"
            local slot = v4.CarrierUserId == nil and not dropped and v4.State == "Slot"
            local eligible
            if arg2["Auto Recover Egg"] and dropped and v4.OwnerUserId == services.LocalPlayer.UserId then
                eligible = true
            elseif arg2["Snipe Dropped Egg"] and dropped then
                eligible = true
            else
                slot = arg2["Auto Farm Egg"] and slot
                eligible = slot and true or false
            end

            if eligible and arg2["Auto Large Egg"] then
                if (tonumber(v4.AssetScale) or 0) < 2 then eligible = false end
            end

            if eligible and arg2["Ignore Friends"] then
                local num = tonumber(v4.OwnerUserId)
                if num and num ~= services.LocalPlayer.UserId then
                    local ok, isFriend = pcall(services.LocalPlayer.IsFriendsWith, services.LocalPlayer, num)
                    if ok and isFriend then eligible = false end
                end
            end

            if eligible and uid and failed[uid] and now - failed[uid] < 8 then eligible = false end
            if #areaFilter > 0 and not table.find(areaFilter, v4.AreaId) then eligible = false end
            if #eggFilter > 0 and not table.find(eggFilter, v4.AssetCategory) then eligible = false end
            local rarity = arg3.EggRarity[v4.AssetCategory]
            local rank = arg3.RarityData[rarity] or 0
            if #rarityFilter > 0 and rarity and not table.find(rarityFilter, rarity) then eligible = false end
            if minRank > 0 and rank < minRank then eligible = false end
            if eligible and v4.BottomCFrame then
                local d = (v4.BottomCFrame.Position - position).Magnitude
                if arg2["Prioritize Rarity"] then
                    if rank > bestRank or (rank == bestRank and d < bestDist) then
                        best = { Record = v4, Position = v4.BottomCFrame.Position }
                        bestRank = rank
                        bestDist = d
                    end
                elseif d < bestDist then
                    best = { Record = v4, Position = v4.BottomCFrame.Position }
                    bestDist = d
                end
            end
        end
    end
    return best
end

function autoFarmEgg.carryEgg(arg, arg2, arg3)
    if not arg2 or not arg2.Record then return false end
    local record = arg2.Record
    local uid = record.Uid
    local prompt, dist = findNearestPrompt(arg2.Position)
    if not prompt or dist > 15 then
        prompt, dist = findNearestPrompt(arg2.Position, true)
    end
    if not prompt or dist > 15 then
        autoFarmEgg.FailedEggs = autoFarmEgg.FailedEggs or {}
        autoFarmEgg.FailedEggs[uid] = os.clock()
        autoFarmEgg.Status = "Skipped stale egg: " .. tostring(uid)
        return false
    end
    autoFarmEgg.Status = "Navigating safely to egg: " .. tostring(record.AssetCategory)
    local parent = prompt.Parent
    local cframe = CFrame.lookAt(parent.Position + Vector3.new(0, 0, 5), parent.Position)
    local hrp = stealEggTeleport.getHRP()
    local hub = stealEggTeleport.getSafeHubCF()
    if hrp and hub and (hrp.Position - hub.Position).Magnitude > 10 then
        autoFarmEgg.Status = "Moving through safe hub"
        if not stealEggTeleport.smartTeleport(hub, arg3) then
            autoFarmEgg.Status = "Safe hub teleport failed"
            return false
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.15)
    end
    autoFarmEgg.Status = "Approaching egg: " .. tostring(record.AssetCategory)
    if not stealEggTeleport.smartTeleport(cframe, arg3) then
        autoFarmEgg.Status = "Egg teleport failed"
        return false
    end
    local hrp2 = stealEggTeleport.getHRP()
    local hum = hrp2 and hrp2.Parent:FindFirstChildOfClass("Humanoid")
    if not hrp2 or not hum or hum.Health <= 0 then
        autoFarmEgg.Status = "Egg teleport aborted: character died"
        return false
    end
    local parent2 = prompt.Parent
    local range = math.max(tonumber(prompt.MaxActivationDistance) or 8, 8)
    local d = (hrp2.Position - parent2.Position).Magnitude
    if d > range then
        autoFarmEgg.Status = "Egg teleport ended too far: " .. string.format("%.1f", d)
        return false
    end
    hrp2.CFrame = cframe
    hrp2.AssemblyLinearVelocity = Vector3.zero
    hrp2.AssemblyAngularVelocity = Vector3.zero
    hum.PlatformStand = false
    hum:ChangeState(Enum.HumanoidStateType.Running)
    hum:Move(Vector3.zero)
    hum.AutoRotate = false

    local p2, d2 = findNearestPrompt(arg2.Position, true)
    local deadline = os.clock() + 0.5
    while (not p2 or not p2.Enabled or d2 > 10) and os.clock() < deadline do
        task.wait(0.05)
        p2, d2 = findNearestPrompt(arg2.Position, true)
    end
    if not p2 or d2 > 10 then
        autoFarmEgg.FailedEggs = autoFarmEgg.FailedEggs or {}
        autoFarmEgg.FailedEggs[uid] = os.clock()
        hum.AutoRotate = true
        if hub then stealEggTeleport.smartTeleport(hub, arg3) end
        autoFarmEgg.Status = "Egg prompt unavailable, retreated safely"
        return false
    end
    autoFarmEgg.Status = "Stealing egg: " .. tostring(uid)
    local hold = math.max(tonumber(p2.HoldDuration) or 0, 0)
    local ok, err = utils.firePrompt(p2)
    if not ok then autoFarmEgg.Status = "Prompt failed: " .. tostring(err) end

    local okSI, slotIdentity = pcall(function()
        return require(services.ReplicatedStorage.Shared.Util.AreaEggSlotIdentity)
    end)
    okSI = okSI and slotIdentity and type(slotIdentity.LooksLikeFirstAreaUid) == "function" and slotIdentity.LooksLikeFirstAreaUid(uid) and type(slotIdentity.SlotKey) == "function"
    local slotKey = nil
    if okSI then slotKey = slotIdentity.SlotKey(record.AreaId, record.NestId) end

    local carryDeadline = os.clock() + math.max(4, hold + 2)
    local nextPrompt = os.clock() + math.max(0.25, hold)
    autoFarmEgg.LastCarryDebug = { Uid = uid, SlotKey = slotKey, Attempts = 0, StartedAt = os.clock() }
    local nextRequest = 0
    local carried = false

    while os.clock() < carryDeadline do
        local character = services.LocalPlayer.Character
        local hum2 = character and character:FindFirstChildOfClass("Humanoid")
        local hrp3 = character and character:FindFirstChild("HumanoidRootPart")
        if not hum2 or hum2.Health <= 0 then break end
        if hrp3 and p2.Parent and p2.Parent.Parent then
            if (hrp3.Position - p2.Parent.Position).Magnitude > math.max(range - 1, 4) then
                hrp3.CFrame = cframe
            end
            hrp3.AssemblyLinearVelocity = Vector3.zero
            hrp3.AssemblyAngularVelocity = Vector3.zero
        end
        if os.clock() >= nextPrompt and p2.Enabled then
            utils.firePrompt(p2)
            nextPrompt = os.clock() + math.max(0.6, hold + 0.2)
        end
        if nextRequest <= os.clock() then
            autoFarmEgg.Status = "Requesting carry: " .. tostring(uid)
            if arg and type(arg.CarryFieldEgg) == "function" then
                local ok2, response, detail = pcall(arg.CarryFieldEgg, uid, slotKey)
                if ok2 and response ~= true then
                    local remotes = services.ReplicatedStorage.Shared.Remotes
                    remotes = remotes and remotes:FindFirstChild("EggWorld")
                    remotes = remotes and remotes:FindFirstChild("AskFieldEggCarry")
                    if remotes and remotes:IsA("RemoteFunction") then
                        local v11
                        ok2, response, v11 = utils.invoke(remotes, 2.5, { Uid = tostring(uid), SlotKey = slotKey })
                        detail = v11 or "AskFieldEggCarry table fallback"
                    end
                end
                local dbg2 = autoFarmEgg.LastCarryDebug
                dbg2.Attempts = dbg2.Attempts + 1
                dbg2.CallOk = ok2
                dbg2.Response = response
                dbg2.Detail = detail
                dbg2.HRPPosition = hrp3 and hrp3.Position
                dbg2.PromptDistance = hrp3 and p2.Parent and (hrp3.Position - p2.Parent.Position).Magnitude or nil
                dbg2.EggDistance = hrp3 and (hrp3.Position - arg2.Position).Magnitude or nil
                dbg2.LastAt = os.clock()
            end
            nextRequest = os.clock() + 0.2
        end

        for _, container in ipairs({ character, services.LocalPlayer:FindFirstChildOfClass("Backpack") }) do
            if container then
                for _, tool in ipairs(container:GetChildren()) do
                    local it = tool:IsA("Tool") and tool:GetAttribute("ItemType")
                    if (it == "AssetEgg" or it == "Asset") and tostring(tool:GetAttribute("UID")) == tostring(uid) then
                        carried = true
                        break
                    end
                end
            end
            if carried then break end
        end

        local readField = type(arg.ReadFieldEggs) == "function" and utils.try(arg.ReadFieldEggs)
        local recs = readField and readField.Records or {}
        for _, rec in pairs(recs) do
            if tostring(rec.Uid) == tostring(uid) and rec.CarrierUserId == services.LocalPlayer.UserId then
                carried = true
                break
            end
        end
        if carried then break end
        task.wait(0.05)
    end

    if hum then hum.AutoRotate = true end
    autoFarmEgg.Status = carried and "Carry confirmed -> safe hub" or "Carry failed at egg"
    if carried then
        autoFarmEgg.LastSuccessfulCarry = {
            Uid = uid,
            Category = record.AssetCategory,
            AreaId = record.AreaId,
            SlotKey = slotKey,
            Attempts = autoFarmEgg.LastCarryDebug and autoFarmEgg.LastCarryDebug.Attempts or 0,
            Time = os.clock(),
        }
        if hub then stealEggTeleport.smartTeleport(hub, arg3) end
        return true
    end
    autoFarmEgg.FailedEggs = autoFarmEgg.FailedEggs or {}
    autoFarmEgg.FailedEggs[uid] = os.clock()
    autoFarmEgg.Status = "Steal failed, trying next egg"
    return false
end

function autoFarmEgg.bringHeldHome(arg, arg2, arg3, arg4, arg5)
    local v = autoFarmEgg.getPlotStand(arg2)
    if not v then
        autoFarmEgg.Status = "Cannot find plot stand"
        return false
    end
    autoFarmEgg.Status = "Carrying egg -> Returning to plot"
    stealEggTeleport.smartTeleport(v, arg3)
    if arg4["Auto Place Egg"] and not autoFarmEgg.Placing then
        autoFarmEgg.Placing = true
        autoFarmEgg.Status = "Placing egg on plot slot"
        local character = services.LocalPlayer.Character
        local uid = nil
        if character then
            for _, child in ipairs(character:GetChildren()) do
                if child:IsA("Tool") and child:GetAttribute("ItemType") == "AssetEgg" and child:GetAttribute("UID") then
                    uid = child:GetAttribute("UID")
                    break
                end
            end
        end
        uid = uid or (arg5.Carry and arg5.Carry.Uid)
        if not uid and arg and type(arg.ReadFieldEggs) == "function" then
            local rr = utils.try(arg.ReadFieldEggs)
            if rr and type(rr.Records) == "table" then
                for _, rec in next, rr.Records, nil do
                    if type(rec) == "table" and rec.CarrierUserId == services.LocalPlayer.UserId then
                        uid = rec.Uid
                        break
                    end
                end
            end
        end
        if uid and arg and type(arg.PlantEgg) == "function" then
            local plot = arg2 and type(arg2.ResolvePlot) == "function" and utils.try(arg2.ResolvePlot)
            local petArea = type(plot) == "table" and plot.PetArea
            if petArea and petArea:IsA("BasePart") then
                local slots = {}
                local nx = math.max(0, petArea.Size.X / 2 - 6)
                local nz = math.max(0, petArea.Size.Z / 2 - 6)
                for i = -nx, nx, 10 do
                    for j = -nz, nz, 10 do
                        slots[#slots + 1] = CFrame.new(i, petArea.Size.Y / 2, j)
                    end
                end
                local idx = math.clamp(tonumber(arg5.NextEggPlaceSlot) or 1, 1, math.max(#slots, 1))
                local err = "No free egg position"
                local placed = false
                local chosen = nil
                for i = 0, math.min(3, #slots - 1) do
                    local n4 = (idx + i - 1) % #slots + 1
                    chosen = slots[n4]
                    local ok, r = utils.try(arg.PlantEgg, uid, chosen)
                    if ok == true then
                        arg5.NextEggPlaceSlot = n4 % #slots + 1
                        placed = true
                        err = nil
                        break
                    elseif r then
                        err = r
                        chosen = nil
                    else
                        chosen = nil
                    end
                end
                if not placed and #slots > 0 then
                    arg5.NextEggPlaceSlot = (idx + 3) % #slots + 1
                end
                arg5.LastEggPlacement = { Uid = uid, Success = placed, Error = err, LocalCFrame = chosen, Time = os.clock() }
                autoFarmEgg.Status = placed and "Egg placed successfully" or "Place egg failed: " .. tostring(err)
            else
                autoFarmEgg.Status = "Cannot resolve plot PetArea"
            end
        end
        task.wait(0.5)
        autoFarmEgg.Placing = false
    end
    if not arg4["Auto Place Egg"] and not arg4["Auto Sell Egg"] then
        local character = services.LocalPlayer.Character
        local uid = nil
        if character then
            for _, child in ipairs(character:GetChildren()) do
                if child:IsA("Tool") and child:GetAttribute("ItemType") == "AssetEgg" and child:GetAttribute("UID") then
                    uid = tostring(child:GetAttribute("UID"))
                    break
                end
            end
        end
        if uid and arg and type(arg.DoffEggTool) == "function" then
            local ok, result, err = pcall(arg.DoffEggTool, uid)
            arg5.LastEggDoff = { Uid = uid, Success = ok and result == true, Error = err or result, Time = os.clock() }
            autoFarmEgg.Status = (ok and result == true) and "Egg stored -> farming continues" or "Could not store held egg"
        end
    elseif arg4["Auto Sell Egg"] then
        autoFarmEgg.Status = "At base -> waiting for Auto Sell Egg"
    end
    return true
end

function autoFarmEgg.step(arg, arg2, arg3, arg4, arg5)
    local busy = autoFarmEgg.Busy or stealEggTeleport.IsTeleporting
    if not busy then busy = os.clock() < (autoFarmEgg.NextFarmAt or 0) end
    if busy then return end
    if not arg3["Auto Farm Egg"] and not arg3["Auto Recover Egg"] and not arg3["Snipe Dropped Egg"] and not arg3["Auto Place Egg"] then
        return
    end
    local character = services.LocalPlayer.Character
    if not (character and character:FindFirstChild("HumanoidRootPart")) then return end
    local speed = tonumber(arg3["Tween Speed"]) or 620
    local carrying = arg4.Carry and arg4.Carry.IsCarrying == true
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") and child:GetAttribute("ItemType") == "AssetEgg" and child:GetAttribute("UID") then
            carrying = true
            break
        end
    end
    if not carrying and arg and type(arg.ReadFieldEggs) == "function" then
        local rr = utils.try(arg.ReadFieldEggs)
        local recs = rr and rr.Records or {}
        for _, rec in pairs(recs) do
            if type(rec) == "table" and rec.CarrierUserId == services.LocalPlayer.UserId then
                carrying = true
                break
            end
        end
    end
    autoFarmEgg.Busy = true
    local farmed = false
    local ok, result = pcall(function()
        if carrying then
            autoFarmEgg.bringHeldHome(arg, arg2, speed, arg3, arg4, arg5)
            return
        end
        arg4.FarmIdle = false
        local target = autoFarmEgg.scanEggs(arg, arg3, arg4)
        if not target then
            arg4.FarmIdle = true
            if autoFarmEgg.Status ~= "Waiting for night phase" then
                autoFarmEgg.Status = "Idle: No matching egg found"
            end
            return
        end
        arg4.FarmIdle = false
        farmed = autoFarmEgg.carryEgg(arg, target, speed) == true
    end)
    autoFarmEgg.Busy = false
    local delay = tonumber(arg3["Delay to Farm Egg"]) or 0
    autoFarmEgg.NextFarmAt = os.clock() + (farmed and math.max(delay, 1.5) or math.max(delay, 0.25))
    if not ok then
        stealEggTeleport.stop()
        autoFarmEgg.NextFarmAt = os.clock() + 1.5
        autoFarmEgg.Status = "Farm error: " .. tostring(result)
    end
end

