stealEggTeleport.smartTeleport = function(arg, arg2, arg3, arg4)
    local v = stealEggTeleport.getHRP()
    if not v then return false end
    if typeof(arg) == "Vector3" then arg = CFrame.new(arg) end
    if typeof(arg) ~= "CFrame" then return false end
    local v2 = applyMinSafe(arg)
    if (v2.Position - v.Position).Magnitude < 4 then
        v.CFrame = v2
        v.AssemblyLinearVelocity = Vector3.zero
        v.AssemblyAngularVelocity = Vector3.zero
        return true
    end
    if stealEggTeleport.IsTeleporting then return false end
    stealEggTeleport.Generation = stealEggTeleport.Generation + 1
    local generation = stealEggTeleport.Generation
    stealEggTeleport.IsTeleporting = true
    local speed = math.clamp(tonumber(arg2) or 680, 50, 900)
    local humanoid = v.Parent:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        stealEggTeleport.IsTeleporting = false
        return false
    end
    stealEggTeleport.ActiveHumanoid = humanoid
    stealEggTeleport.PreviousPlatformStand = humanoid.PlatformStand
    humanoid.PlatformStand = false
    local v3 = stealEggTeleport.expandTweenLeg(v.Position, v2.Position, speed >= 600 and 120 or 90)
    local tbl2 = { Label = arg4 or "default" }
    tbl2.StartedAt = os.clock()
    tbl2.StartPosition = v.Position
    tbl2.TargetPosition = v2.Position
    tbl2.LegCount = #v3
    tbl2.CurrentLeg = 0
    tbl2.Speed = speed
    tbl2.MaxDrift = 0
    dbg(tbl2)
    local parent = v.Parent
    local completed = #v3 > 0
    if not completed then tbl2.Failure = "route unavailable" end

    local function fail(failure, failedLeg)
        completed = false
        tbl2.Failure = failure
        tbl2.FailedLeg = failedLeg
    end

    for i, v4 in ipairs(v3) do
        if completed then
            if generation ~= stealEggTeleport.Generation or not stealEggTeleport.IsTeleporting then
                fail("cancelled", i)
                break
            elseif services.LocalPlayer.Character ~= parent or not v.Parent or not humanoid.Parent or humanoid.Health <= 0 then
                fail("character changed or died", i)
                break
            else
                local v5, v6 = safeWaypoint(i == #v3 and v2 or v4, v)
                if not v5 then
                    fail(v6 or "unsafe waypoint", i)
                    break
                else
                    local cFrame = v.CFrame
                    local magnitude = (cFrame.Position - v5.Position).Magnitude
                    local n = math.max(magnitude / speed, 0.025)
                    local now = os.clock()
                    local v7 = nil
                    tbl2.CurrentLeg = i
                    tbl2.BeforePosition = cFrame.Position
                    tbl2.LegTarget = v5.Position
                    tbl2.LegDistance = magnitude
                    tbl2.HealthBefore = humanoid.Health
                    tbl2.BeforeAt = now
                    local tween = services.TweenService:Create(v, TweenInfo.new(n, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), { CFrame = v5 })
                    stealEggTeleport.CurrentTween = tween
                    local connection = tween.Completed:Connect(function(playbackState)
                        v7 = playbackState
                    end)
                    stealEggTeleport.CurrentConnection = connection
                    tween:Play()
                    while v7 == nil do
                        services.RunService.Heartbeat:Wait()
                        local n2 = os.clock() - now
                        if generation ~= stealEggTeleport.Generation or not stealEggTeleport.IsTeleporting then
                            fail("cancelled", i)
                            break
                        elseif services.LocalPlayer.Character ~= parent or not v.Parent or not humanoid.Parent or humanoid.Health <= 0 then
                            fail("character changed or died", i)
                            break
                        elseif n + 0.75 < n2 then
                            fail("waypoint timeout", i)
                            break
                        else
                            local n3 = math.clamp(n2 / n, 0, 1)
                            local magnitude2 = (v.Position - cFrame.Position:Lerp(v5.Position, n3)).Magnitude
                            tbl2.MaxDrift = math.max(tbl2.MaxDrift, magnitude2)
                            if magnitude2 > math.max(28, magnitude * 0.65) and n2 > 0.12 then
                                fail("server position correction", i)
                                break
                            end
                        end
                    end
                    connection:Disconnect()
                    if stealEggTeleport.CurrentConnection == connection then
                        stealEggTeleport.CurrentConnection = nil
                    end
                    stealEggTeleport.CurrentTween = nil
                    tbl2.PlaybackState = v7 and tostring(v7) or "Aborted"
                    tbl2.AfterPosition = v.Parent and v.Position or nil
                    tbl2.HealthAfter = humanoid.Parent and humanoid.Health or nil
                    tbl2.AfterAt = os.clock()
                    dbg(tbl2)
                    if completed and v7 ~= Enum.PlaybackState.Completed then
                        fail("tween did not complete", i)
                    end
                    if completed then
                        v.AssemblyLinearVelocity = Vector3.zero
                        v.AssemblyAngularVelocity = Vector3.zero
                        if arg3 then arg3(i, #v3) end
                    end
                    continue
                end
            end
        end
        break
    end
    if generation == stealEggTeleport.Generation then
        stealEggTeleport.IsTeleporting = false
    end
    stealEggTeleport.CurrentTween = nil
    if stealEggTeleport.CurrentConnection then
        stealEggTeleport.CurrentConnection:Disconnect()
        stealEggTeleport.CurrentConnection = nil
    end
    restorePlatform()
    if v and v.Parent then
        v.AssemblyLinearVelocity = Vector3.zero
        v.AssemblyAngularVelocity = Vector3.zero
    end
    tbl2.Completed = completed
    tbl2.EndPosition = v and v.Parent and v.Position or nil
    tbl2.EndedAt = os.clock()
    dbg(tbl2)
    return completed
end

stealEggTeleport.stop = function()
    stealEggTeleport.Generation = stealEggTeleport.Generation + 1
    stealEggTeleport.IsTeleporting = false
    if stealEggTeleport.CurrentTween then
        pcall(function() stealEggTeleport.CurrentTween:Cancel() end)
        stealEggTeleport.CurrentTween = nil
    end
    if stealEggTeleport.CurrentConnection then
        stealEggTeleport.CurrentConnection:Disconnect()
        stealEggTeleport.CurrentConnection = nil
    end
    restorePlatform()
    local v = stealEggTeleport.getHRP()
    if v then
        v.AssemblyLinearVelocity = Vector3.zero
        v.AssemblyAngularVelocity = Vector3.zero
    end
end

