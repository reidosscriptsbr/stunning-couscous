-- ============ AUTO FARM EGG ============
local autoFarmEgg = {
    Placing = false,
    Busy = false,
    Status = "idle",
    FailedEggs = {},
    LastCarryDebug = nil,
    LastSuccessfulCarry = nil,
    NextFarmAt = 0,
    PromptCache = {},
    PromptCacheAt = 0,
}

local function getStealPrompts(force)
    local now = os.clock()
    local flag = not force
    if flag then flag = now - (autoFarmEgg.PromptCacheAt or 0) < 1.25 end
    if flag then return autoFarmEgg.PromptCache end
    local cache = {}
    for _, d in ipairs(services.Workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.ActionText == "Steal" and d.Parent and d.Parent:IsA("BasePart") then
            cache[#cache + 1] = d
        end
    end
    autoFarmEgg.PromptCache = cache
    autoFarmEgg.PromptCacheAt = now
    return cache
end

local function findNearestPrompt(pos, force)
    local best, bestDist = nil, math.huge
    for _, p in ipairs(getStealPrompts(force)) do
        if p.Parent and p.Parent.Parent then
            local d = (p.Parent.Position - pos).Magnitude
            if d < bestDist then
                bestDist = d
                best = p
            end
        end
    end
    return best, bestDist
end

