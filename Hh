local inventoryManager = {}

local function readPets(arg)
    local pets, map, fusePets, fuseMap = {}, {}, {}, {}
    local save = arg.Save and utils.try(arg.Save.Get)
    local decode = arg.AssetItems and arg.AssetItems.Decode
    if type(save) ~= "table" or type(save.Inventory) ~= "table" or type(decode) ~= "function" then
        return pets, map, fusePets, fuseMap
    end
    local equipped = type(save.EquippedAssets) == "table" and save.EquippedAssets or {}

    local function shortId(s)
        s = tostring(s or "")
        return #s > 10 and s:sub(1, 6) .. "..." .. s:sub(-4) or s
    end

    for k, v in pairs(save.Inventory) do
        local d = utils.try(decode, v)
        if type(d) == "table" then
            local uid = tostring(k)
            local locked = d.IsFavorite == true or d.InFuse == true or table.find(equipped, uid) ~= nil
            local label = string.format("%s | %s%s | %.2fkg | %s",
                locked and "[LOCKED] Pet" or "Pet",
                d.BaseMutation and tostring(d.BaseMutation) .. " " or "",
                tostring(d.AssetCategory or d.Category or "Unknown"),
                tonumber(d.AssetScale or d.Scale) or 0,
                shortId(uid))
            pets[#pets + 1] = label
            map[label] = { Uid = uid, Item = d, Locked = locked, Category = tostring(d.AssetCategory or d.Category or "Unknown") }
            if not locked then
                local fl = string.format("Fuse Pet | %s%s | %.2fkg | %s",
                    d.BaseMutation and tostring(d.BaseMutation) .. " " or "",
                    tostring(d.AssetCategory or d.Category or "Unknown"),
                    tonumber(d.AssetScale or d.Scale) or 0,
                    shortId(uid))
                fusePets[#fusePets + 1] = fl
                fuseMap[fl] = { Uid = uid, Item = d, Category = tostring(d.AssetCategory or d.Category or "Unknown") }
            end
        end
    end
    table.sort(pets)
    table.sort(fusePets)
    return pets, map, fusePets, fuseMap
end

local function readEggs(arg)
    local names, map = {}, {}
    local save = arg.Save and type(arg.Save.Get) == "function" and utils.try(arg.Save.Get)
    local eggInv = type(save) == "table" and save.EggInventory
    if type(eggInv) ~= "table" then return names, map end
    for k, v in pairs(eggInv) do
        if type(v) == "table" then
            local uid = tostring(k)
            local cat = tostring(v.AssetCategory or "Unknown")
            if not map[cat] then
                map[cat] = { Category = cat, DisplayName = cat, Entries = {} }
                names[#names + 1] = cat
            end
            map[cat].Entries[#map[cat].Entries + 1] = { Uid = uid, Record = v }
        end
    end
    table.sort(names)
    for _, v in pairs(map) do
        table.sort(v.Entries, function(a, b)
            return (tonumber(a.Record.AssetScale) or 0) < (tonumber(b.Record.AssetScale) or 0)
        end)
    end
    return names, map
end

function inventoryManager.refresh(arg, arg2, arg3)
    local pets, petMap, fusePets, fuseMap = readPets(arg)
    local eggNames, eggMap = readEggs(arg)
    arg2.PetInventoryMap = petMap
    arg2.FusePetInventoryMap = fuseMap
    arg2.EggInventoryMap = eggMap
    return #pets, #eggNames, #fusePets, pets, eggNames, fusePets
end

function inventoryManager.resetEggBatch(arg)
    arg.SelectedEggQueue = nil
    arg.SelectedEggQueueLabel = nil
    arg.EggPlaceCache = nil
end

function inventoryManager.getHeldEggTool()
    local character = services.LocalPlayer.Character
    if not character then return nil end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") and child:GetAttribute("ItemType") == "AssetEgg" and child:GetAttribute("UID") then
            return child
        end
    end
    return nil
end

local function buildEggQueue(arg)
    local sel = arg.SelectedEggLabel
    if arg.SelectedEggQueueLabel ~= sel or type(arg.SelectedEggQueue) ~= "table" then
        local map = arg.EggInventoryMap or {}
        local entry = map[sel]
        if not entry then return nil, "Select an egg name first" end
        local q = {}
        for _, e in ipairs(entry.Entries or {}) do
            q[#q + 1] = { Uid = tostring(e.Uid), Record = e.Record }
        end
        arg.SelectedEggQueue = q
        arg.SelectedEggQueueLabel = sel
        arg.EggPlaceCache = nil
    end
    return arg.SelectedEggQueue
end

function inventoryManager.placeEgg(arg, arg2)
    local queue, err = buildEggQueue(arg2)
    if not queue then return false, err end
    local held = inventoryManager.getHeldEggTool()
    if not held then
        while #queue > 0 do
            local item = queue[1]
            local ok, r, e = pcall(arg.EggState.WearEggTool, item.Uid)
            if ok and r == true then
                local deadline = os.clock() + 0.8
                while os.clock() < deadline do
                    task.wait(0.08)
                    local h = inventoryManager.getHeldEggTool()
                    if h and tostring(h:GetAttribute("UID")) == item.Uid then
                        held = h
                        break
                    end
                end
                if held then break end
            end
            table.remove(queue, 1)
        end
    end
    if not held then return false, "No wearable egg" end

    local uid = tostring(held:GetAttribute("UID"))
    local plot = arg.PlotState and utils.try(arg.PlotState.ResolvePlot)
    local petArea = type(plot) == "table" and plot.PetArea
    if not petArea or not petArea:IsA("BasePart") then
        return false, "PetArea unavailable"
    end

    local respawn = arg.PlotState and utils.try(arg.PlotState.FindRespawnCFrame)
    if respawn then
        local stand = CFrame.new(respawn.Position + Vector3.new(0, 5, 0)) * respawn.Rotation
        local hrp = services.LocalPlayer.Character and services.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.Position - stand.Position).Magnitude > 14 then
            stealEggTeleport.smartTeleport(stand, 600)
        end
    end

    local positions = {}
    local nx = math.max(0, petArea.Size.X / 2 - 6)
    local nz = math.max(0, petArea.Size.Z / 2 - 6)
    for i = -nx, nx, 10 do
        for j = -nz, nz, 10 do
            positions[#positions + 1] = CFrame.new(i, petArea.Size.Y / 2, j)
        end
    end

    for i, slot in ipairs(positions) do
        local ok, r, e = pcall(arg.EggState.PlantEgg, uid, slot)
        if ok and r == true then
            for idx = #queue, 1, -1 do
                if tostring(queue[idx].Uid) == uid then
                    table.remove(queue, idx)
                    break
                end
            end
            return true, "Egg placed"
        end
    end
    return false, "Place rejected"
end

function inventoryManager.sellEgg(arg, arg2)
    local queue, err = buildEggQueue(arg2)
    if not queue then return false, err end
    if not fireproximityprompt then return false, "fireproximityprompt unavailable" end
    local stands = workspace:FindFirstChild("Stands")
    stands = stands and stands:FindFirstChild("Prompts")
    stands = stands and stands:FindFirstChild("SellHeldAsset")
    local prompt = stands and stands:FindFirstChildOfClass("ProximityPrompt")
    if not prompt then return false, "Sell prompt unavailable" end

    local held = inventoryManager.getHeldEggTool()
    if not held then
        while #queue > 0 do
            local item = queue[1]
            local ok, r = pcall(arg.EggState.WearEggTool, item.Uid)
            if ok and r == true then
                local deadline = os.clock() + 0.8
                while os.clock() < deadline do
                    task.wait(0.08)
                    local h = inventoryManager.getHeldEggTool()
                    if h and tostring(h:GetAttribute("UID")) == item.Uid then held = h break end
                end
                if held then break end
            end
            table.remove(queue, 1)
        end
    end
    if not held then return false, "No wearable egg" end

    local uid = tostring(held:GetAttribute("UID"))
    local hrp = services.LocalPlayer.Character and services.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if stands and hrp and (hrp.Position - stands.Position).Magnitude > 14 then
        stealEggTeleport.smartTeleport(stands.CFrame * CFrame.new(0, 3, 5), 600)
    end
    pcall(fireproximityprompt, prompt, prompt.HoldDuration, true)
    task.wait(0.2)
    local playerGui = services.LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local yes = playerGui and playerGui:FindFirstChild("Yes", true)
    if yes and yes:IsA("GuiButton") and yes.Visible then
        pcall(function()
            if firesignal then
                firesignal(yes.MouseButton1Click)
                firesignal(yes.Activated)
            elseif type(yes.Activate) == "function" then
                yes:Activate()
            end
        end)
    end
    task.wait(0.35)
    for idx = #queue, 1, -1 do
        if tostring(queue[idx].Uid) == uid then
            table.remove(queue, idx)
            break
        end
    end
    return true, "Egg sold"
end

