local function poolEntry(tbl, key)
    if type(tbl) ~= "table" or key == nil then return nil end
    local v = tbl[key]
    if not v then
        local t = {}
        tbl[key] = t
        v = t
    end
    return v
end

function espManager.getHighlight(adornee, pool)
    local v = poolEntry(pool, adornee)
    if not v then return nil end
    local h = v.Highlight
    if h and h.Parent then return h end
    local highlight = Instance.new("Highlight")
    highlight.Name = "NevisHighlight"
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    if typeof(adornee) == "Instance" then highlight.Adornee = adornee end
    highlight.Parent = espManager.getFolder()
    v.Highlight = highlight
    return highlight
end

function espManager.applyHighlight(arg, adornee, fillColor, range)
    if typeof(arg) ~= "Instance" or not arg:IsA("Highlight") then return end
    if typeof(adornee) == "Instance" then arg.Adornee = adornee end
    if typeof(fillColor) == "Color3" then
        arg.FillColor = fillColor
        arg.OutlineColor = fillColor
    end
    local now = os.clock()
    if now - espManager.HighlightBudget.t > 0.05 then
        espManager.HighlightBudget.t = now
        espManager.HighlightBudget.n = 0
    end
    local enabled = true
    if range and range > 0 and typeof(adornee) == "Instance" then
        local cam = services.Workspace.CurrentCamera
        local ok, result = pcall(function()
            if adornee:IsA("Model") then return adornee:GetPivot().Position end
            if adornee:IsA("BasePart") then return adornee.Position end
            local bp = adornee:FindFirstChildWhichIsA("BasePart", true)
            return bp and bp.Position
        end)
        if ok and cam and typeof(result) == "Vector3" then
            enabled = (result - cam.CFrame.Position).Magnitude <= range
        end
    end
    if enabled then
        if espManager.HighlightBudget.n >= espManager.ESP_HL_CAP then
            enabled = false
        else
