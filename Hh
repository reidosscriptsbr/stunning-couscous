catalogs.sync = function(arg)
    local assets = catalogs.Assets
    if assets and type(assets.Directory) == "table" then
        for k, v in pairs(assets.Directory) do
            local rarity = type(v) == "table" and (v.Rarity or v.rarity)
            if type(rarity) == "table" then
                local id = rarity._id or rarity.Id or rarity.DisplayName or rarity.Name
                local num = tonumber(rarity.RarityNumber)
                if type(id) == "string" and num then
                    arg.RarityData[id] = num
                    rarity = id
                else
                    rarity = id
                end
            end
            if type(rarity) == "string" then
                arg.EggRarity[k] = rarity
            end
        end
    end
    if type(arg.RarityData) == "table" and next(arg.RarityData) then
        local tbl3 = {}
        for k, v in pairs(arg.RarityData) do
            if type(v) == "number" then table.insert(tbl3, { k, v }) end
        end
        table.sort(tbl3, function(a, b) return a[2] < b[2] end)
        arg.EspColor = arg.EspColor or {}
        local n = #tbl3
        for i, v in ipairs(tbl3) do
            if arg.EspColor[v[1]] == nil then
                arg.EspColor[v[1]] = Color3.fromHSV(0.33 * (1 - (n > 1 and (i - 1) / (n - 1) or 0)), 0.85, 1)
            end
        end
    end
    local areas = catalogs.Areas
    if areas and type(areas.Directory) == "table" then
        arg.AreaList = {}
        for k in pairs(areas.Directory) do
            arg.AreaList[#arg.AreaList + 1] = tostring(k)
        end
        table.sort(arg.AreaList)
    end
end

