local antiTrap = { scanTraps = function(arg, arg2)
    local hrp = stealEggTeleport.getHRP()
    if not hrp then return false end
    local traps = {}
    for _, tag in ipairs({ "PlacedTrap", "Tripmine", "MineTrap" }) do
        for _, t in ipairs(services.CollectionService:GetTagged(tag)) do
            if t:IsA("BasePart") or t:IsA("Model") then
                traps[#traps + 1] = t
            end
        end
    end
    arg2.__traps = traps
    if arg["Anti Tripmine"] then
        local position = hrp.Position
        for _, trap in ipairs(traps) do
            local bp = trap:IsA("BasePart") and trap or trap:FindFirstChildWhichIsA("BasePart")
            if bp then
                if (Vector3.new(bp.Position.X, 0, bp.Position.Z) - Vector3.new(position.X, 0, position.Z)).Magnitude < 60 then
                    espManager.applyHighlight(espManager.getHighlight(bp, espManager.PlotEspPool), bp, Color3.fromRGB(255, 80, 80), 1000)
                end
            end
        end
    end
    return false
end }

